generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USER & AUTH ====================
model User {
  id                      String   @id @default(cuid())
  email                   String   @unique
  phone                   String?   @unique
  passwordHash            String?
  googleId                String?  @unique
  emailVerified           Boolean  @default(false)
  firstName               String
  lastName                String?
  dateOfBirth             DateTime?
  gender                  Gender?
  heightCm                Float?
  weightKg                Float?
  goal                    TrainingGoal?
  fitnessLevel            FitnessLevel?
  trainingExperienceYears Int?
  avatarUrl               String?
  role                    UserRole  @default(CLIENT)
  gymId                   String?
  weekPlan                Json?

  vkId                    String?   @unique
  phoneVerified           Boolean   @default(false)

  totpSecret              String?   // base32 TOTP secret (set during 2FA setup, before enabled)
  totpEnabled             Boolean   @default(false)
  totpBackupCodes         String?   // JSON: [{hash: string, used: boolean}] — single-use recovery codes

  isBanned                Boolean   @default(false)
  bannedAt                DateTime?
  banReason               String?
  adminNote               String?

  // Login lockout (brute-force protection)
  loginAttempts           Int       @default(0)
  lockedUntil             DateTime?

  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  healthRestrictions      HealthRestriction[]
  programs                Program[]
  workouts                Workout[]
  meals                   Meal[]
  bodyWeights             BodyWeight[]
  bodyMeasurements        BodyMeasurement[]
  chatMessages            ChatMessage[]
  savedNews               SavedNews[]
  subscription            Subscription?
  aiMemories              AIMemory[]
  trainerClients          TrainerClient[]
  cardioSessions          CardioSession[]
  supportTickets          SupportTicket[]  @relation("UserTickets")
  assignedTickets         SupportTicket[]  @relation("StaffTickets")
  supportMessages         SupportMessage[] @relation("MessageAuthor")
  adminLogs               AdminLog[]       @relation("AdminLogs")
  sleepEntries            SleepEntry[]
  announcements           Announcement[]   @relation("Announcements")

  gym                     Gym?      @relation(fields: [gymId], references: [id])
  passwordResetTokens     PasswordResetToken[]
  passwordHistory         PasswordHistory[]
  refreshTokens           RefreshToken[]
  pushTokens              PushToken[]
}

enum Gender {
  MALE
  FEMALE
}

enum TrainingGoal {
  WEIGHT_LOSS
  MUSCLE_GAIN
  STRENGTH
  ENDURANCE
  FLEXIBILITY
  GENERAL_FITNESS
}

enum FitnessLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum UserRole {
  GUEST
  VISITOR
  CLIENT
  TRAINER
  SUPPORT
  ADMIN
}

model HealthRestriction {
  id          String @id @default(cuid())
  bodyPart    String
  description String
  severity    String // mild, moderate, severe
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==================== GYM ====================
model Gym {
  id       String @id @default(cuid())
  name     String
  address  String?
  phone    String?
  members  User[]
}

// ==================== EXERCISES ====================
model Exercise {
  id               String   @id @default(cuid())
  name             String
  description      String
  instructions     String[]
  primaryMuscles   String[]
  secondaryMuscles String[]
  type             String   // barbell, dumbbell, machine, etc.
  category         String   // strength, cardio, flexibility, functional
  difficulty       String
  videoUrl         String?
  imageUrl         String?

  workoutExercises WorkoutExercise[]
}

// ==================== PROGRAMS & WORKOUTS ====================
model Program {
  id            String   @id @default(cuid())
  name          String
  description   String?
  type          String   // push_pull_legs, upper_lower, etc.
  goal          TrainingGoal
  level         FitnessLevel
  daysPerWeek   Int
  durationWeeks Int?
  isActive      Boolean  @default(false)
  createdBy     String   // system, user, ai
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  workouts      Workout[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model Workout {
  id              String    @id @default(cuid())
  clientId        String?   @unique // client-generated ID for offline-first idempotency
  name            String
  description     String?
  scheduledDate   DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  durationMinutes Int?
  totalVolume     Float?
  notes           String?

  programId       String?
  program         Program?  @relation(fields: [programId], references: [id], onDelete: SetNull)
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  exercises       WorkoutExercise[]

  createdAt       DateTime  @default(now())

  @@index([userId])
  @@index([completedAt])
}

model WorkoutExercise {
  id              String @id @default(cuid())
  order           Int
  restSeconds     Int    @default(90)
  supersetGroupId String?
  notes           String?

  workoutId       String
  workout         Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId      String
  exercise        Exercise @relation(fields: [exerciseId], references: [id])

  sets            WorkoutSet[]

  @@index([workoutId])
}

model WorkoutSet {
  id                String  @id @default(cuid())
  setNumber         Int
  type              String  @default("normal") // normal, warmup, dropset, superset, failure
  reps              Int?
  weight            Float?
  duration          Int?    // seconds
  distance          Float?  // meters
  rpe               Int?    // 1-10
  completed         Boolean @default(false)
  notes             String?

  workoutExerciseId String
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@index([workoutExerciseId])
}

// ==================== NUTRITION ====================
model Meal {
  id             String   @id @default(cuid())
  type           String   // breakfast, lunch, dinner, snack
  photoUrl       String?
  totalCalories  Float
  totalProtein   Float
  totalFats      Float
  totalCarbs     Float
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  items          MealItem[]

  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model MealItem {
  id          String @id @default(cuid())
  name        String
  calories    Float
  protein     Float
  fats        Float
  carbs       Float
  weightGrams Float
  imageUrl    String?

  mealId      String
  meal        Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@index([mealId])
}

// ==================== PROGRESS ====================
model BodyWeight {
  id       String   @id @default(cuid())
  weightKg Float
  date     DateTime
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model BodyMeasurement {
  id      String   @id @default(cuid())
  date    DateTime
  userId  String
  chest   Float?
  waist   Float?
  hips    Float?
  bicep   Float?
  thigh   Float?
  calf    Float?
  neck    Float?
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

// ==================== AI CHAT ====================
model ChatMessage {
  id        String   @id @default(cuid())
  role      String   // user, assistant
  content   String
  actions   Json?    // AI actions performed
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

// ==================== AI MEMORY ====================
model AIMemory {
  id        String   @id @default(cuid())
  category  String   // preference, habit, injury, allergy, schedule, personality
  key       String   // unique identifier: e.g. "preferred_split", "injury_shoulder"
  value     String   // the learned fact
  confidence Float   @default(0.5) // 0-1, increases with repeated confirmation
  source    String   @default("inferred") // inferred, stated, observed
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
}

// ==================== TRAINER ====================
model TrainerClient {
  id              String   @id @default(cuid())
  name            String
  phone           String?
  age             Int?
  goal            String?  // muscle_gain, weight_loss, strength, etc.
  level           String?  // beginner, intermediate, advanced
  assignedProgram String?
  notes           String?
  emoji           String?  @default("🧑")
  totalWorkouts   Int      @default(0)
  lastVisit       DateTime?

  trainerId       String
  trainer         User              @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  sessions        TrainerSession[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TrainerSession {
  id              String   @id @default(cuid())
  clientId        String
  client          TrainerClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date            String   // YYYY-MM-DD
  name            String
  durationMinutes Int
  volumeKg        Float?
  notes           String?

  createdAt       DateTime @default(now())
}

// ==================== NEWS ====================
model NewsArticle {
  id          String   @id @default(cuid())
  title       String
  summary     String
  content     String
  imageUrl    String?
  categories  String[] // russian, powerlifting, records, etc.
  publishedAt DateTime @default(now())

  savedBy     SavedNews[]
}

model SavedNews {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId String
  article   NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  savedAt   DateTime    @default(now())

  @@unique([userId, articleId])
}

// ==================== SUBSCRIPTION ====================
model Subscription {
  id         String   @id @default(cuid())
  plan       String   // free, pro, trainer, club
  status     String   // active, cancelled, expired
  startDate  DateTime
  endDate    DateTime?
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}


// ==================== CARDIO ====================
model CardioSession {
  id             String   @id @default(cuid())
  userId         String
  type           String   // running, cycling, swimming, walking, hiit, elliptical, rowing, other
  date           String   // YYYY-MM-DD
  durationMinutes Int
  distanceKm     Float?
  caloriesBurned Int?
  avgHeartRate   Int?
  notes          String?
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==================== PUSH TOKENS ====================
model PushToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ==================== PASSWORD HISTORY ====================
model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==================== PASSWORD RESET ====================
model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==================== SUPPORT ====================
model SupportTicket {
  id           String   @id @default(cuid())
  subject      String
  category     String   // billing, technical, feature_request, account, bug, other
  status       String   @default("open") // open, in_progress, resolved, closed
  priority     String   @default("normal") // low, normal, high, urgent

  userId       String
  user         User     @relation("UserTickets", fields: [userId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?    @relation("StaffTickets", fields: [assignedToId], references: [id])

  messages     SupportMessage[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([assignedToId])
}

model SupportMessage {
  id         String   @id @default(cuid())
  content    String
  isStaff    Boolean  @default(false)
  isInternal Boolean  @default(false)

  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId  String
  author    User     @relation("MessageAuthor", fields: [authorId], references: [id])

  createdAt DateTime @default(now())

  @@index([ticketId])
}

// ==================== ADMIN LOG ====================
model AdminLog {
  id        String   @id @default(cuid())
  action    String   // VIEW_USER, CHANGE_ROLE, CHANGE_SUBSCRIPTION, CLOSE_TICKET, REPLY_TICKET, BAN_USER
  targetId  String?  // affected userId or ticketId
  details   String?

  adminId   String
  admin     User     @relation("AdminLogs", fields: [adminId], references: [id])

  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
}

// ==================== SLEEP ====================
model SleepEntry {
  id            String   @id @default(cuid())
  date          String   // YYYY-MM-DD
  bedtime       String   // HH:MM
  wakeTime      String   // HH:MM
  durationHours Float
  quality       Int?     // 1-5

  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

// ==================== ANNOUNCEMENTS ====================
model Announcement {
  id         String    @id @default(cuid())
  title      String
  body       String
  type       String    @default("info") // "info", "warning", "maintenance", "promo"
  isActive   Boolean   @default(true)
  endsAt     DateTime?
  targetRole String?   // null = all users, "pro", "free", etc.
  viewCount  Int       @default(0)

  authorId  String
  author    User      @relation("Announcements", fields: [authorId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isActive, createdAt])
}

// ==================== OTP CODES ====================
model OtpCode {
  id        String   @id @default(cuid())
  phone     String?
  email     String?
  code      String
  purpose   String   // "register", "login", "phone-login", "phone-reset", "email-verify"
  used      Boolean  @default(false)
  attempts  Int      @default(0)  // wrong-guess counter; code invalidated at 5
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([email])
}

// ==================== SECURITY EVENTS ====================
model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String?  // null for events before user is identified
  action    String   // LOGIN_SUCCESS, LOGIN_FAIL, PASSWORD_CHANGE, EMAIL_VERIFIED, PHONE_VERIFIED, ACCOUNT_DELETED, OTP_BRUTEFORCE, TOKEN_REVOKED, ACCOUNT_LOCKED
  ip        String?
  userAgent String?
  details   String?  // JSON or plain text extra info

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ==================== REFRESH TOKENS ====================
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}
