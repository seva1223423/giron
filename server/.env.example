DATABASE_URL="postgresql://user:password@localhost:5432/giron"
JWT_SECRET="your-secret-key-here"
JWT_REFRESH_SECRET="your-refresh-secret-here"
PORT=3000

# ── AI Provider (primary) ───────────────────────────────────────────────────
# OpenAI-совместимый endpoint, переключается через env — код не меняется.
# Миграционный план и сравнение провайдеров (cost, latency, страновой риск):
# см. server/src/services/llm/README.md
#
# Mistral AI (сейчас по умолчанию, бесплатный tier 1B токенов/месяц):
#   Регистрация: https://console.mistral.ai
#   Минусы: оплата только через иностранное юрлицо, риск санкционной
#   блокировки РФ. Держать как fallback после миграции на YandexGPT.
AI_BASE_URL=https://api.mistral.ai/v1
AI_MODEL=mistral-small-latest
AI_API_KEY=your-mistral-api-key-here
#
# DeepSeek (альтернатива, $0.14/1M, оплата в $):
#   Регистрация: https://platform.deepseek.com
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat
# AI_API_KEY=your-deepseek-api-key-here
#
# YandexGPT (рекомендуемый primary для РФ, в 3× дешевле Mistral):
#   Документация: https://yandex.cloud/ru/docs/foundation-models/
#   Tariff Lite async: ~120 ₽ / 1M токенов, оплата в ₽ через Yandex Cloud.
#   Плюсы: 0 валютных рисков, нет санкций, нативный русский + казахский.
#   Минус: не OpenAI-совместим нативно — см. llm/README.md для интеграции.
# YANDEX_GPT_API_KEY=your-yc-api-key
# YANDEX_GPT_FOLDER_ID=b1gxxxxxxxxxxxxxxxxx
# YANDEX_GPT_MODEL=yandexgpt-lite/latest
#
# GigaChat (Сбер, fallback для страновой устойчивости):
#   Документация: https://developers.sber.ru/docs/ru/gigachat/
#   Tariff: 190-1950 ₽/1M токенов, freemium 1M токенов.
# GIGACHAT_CLIENT_ID=
# GIGACHAT_CLIENT_SECRET=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
#
# Fallback chain — порядок попыток при ошибке primary. Реализация
# ожидается вместе с подключением альтернативного провайдера (см. README).
# Пример: AI_FALLBACK_CHAIN=mistral,gigachat
# AI_FALLBACK_CHAIN=

# ── Error reporting (Sentry) ────────────────────────────────────────────────
# Optional — wrapper is a no-op until both (a) SENTRY_DSN is set AND
# (b) `npm install @sentry/node` is run in /server. See activation
# checklist in server/src/utils/errorReporter.ts header comment.
# SENTRY_DSN=https://xxxxxxxxxxxxx@o0.ingest.sentry.io/NNN

# ── Admin bootstrap (ADMIN-BOOTSTRAP-01) ────────────────────────────────────
# When set, the user with this email is auto-promoted to role=ADMIN on each
# server boot. Idempotent — no-op once they're already admin. Required for
# the daily admin digest (09:00 МСК cron) to have a recipient.
# ADMIN_BOOTSTRAP_EMAIL=osipovvsevolod01@gmail.com

# ── Client version gate (CLIENT-VERSION-01) ─────────────────────────────────
# Minimum supported client semver. Requests carrying X-Client-Version below
# this get HTTP 426 with a structured payload that the client UI uses to
# show the "Update required" modal. Leave unset (or 0.0.0) to disable the
# gate entirely — required state during early development to avoid false
# rejects from missing headers / curl callers.
# Bump this only when you ship a server change that breaks an old client
# contract — usually right after a binary version bump in app.json.
# MIN_CLIENT_VERSION=1.0.0

# Webhook signature secrets
# ЮKassa — primary payment channel for the RF market.
YUKASSA_WEBHOOK_SECRET=your-yukassa-secret-key
# Generic HMAC signature — optional, for a custom payment integration.
WEBHOOK_SECRET=your-generic-webhook-secret
# RevenueCat is intentionally unsupported: Apple/Google Play Billing is not
# available from RF since 2022. Do not add a REVENUECAT_* env here.

# ── Google OAuth ────────────────────────────────────────────────────────────
# Создать проект: https://console.cloud.google.com → APIs → Credentials
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=

# ── VK OAuth ────────────────────────────────────────────────────────────────
# Создать приложение: https://vk.com/editapp?act=create (тип: Мобильное)
VK_APP_ID=
# Сервисный ключ приложения. Без него токен проверяется только на валидность,
# но НЕ на принадлежность нашему приложению — чужой токен к другому VK-приложению
# прошёл бы как свой (аудит M4). Обязателен, если вход через VK включён.
VK_SERVICE_TOKEN=

# ── Яндекс OAuth ────────────────────────────────────────────────────────────
# Создать приложение: https://oauth.yandex.ru/client/new
# Права: «Доступ к адресу электронной почты» + «Доступ к портрету пользователя».
# Сервер сверяет client_id из ответа /info с этим значением — иначе токен,
# выданный другому приложению, был бы принят как свой.
YANDEX_CLIENT_ID=

# ── Шифрование TOTP-секретов ────────────────────────────────────────────────
# AES-ключ, которым шифруются секреты двухфакторной аутентификации в БД.
# Без него 2FA-секреты легли бы в базу открытым текстом.
# Сгенерировать: openssl rand -hex 32
TOTP_ENC_KEY=

# ── SMS.ru (рекомендуется для России) ───────────────────────────────────────
# Регистрация: https://sms.ru — бесплатный тестовый баланс
# Дешевле и надёжнее Twilio для российских номеров
SMSRU_API_ID=
SMSRU_SENDER=Giron     # опционально: имя отправителя (одобрить в личном кабинете)

# ── Twilio (международный fallback) ─────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password    # Gmail: Account → Security → App Passwords
SMTP_FROM=Giron <noreply@giron.app>
APP_URL=https://giron.app

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed web origins (mobile app doesn't need this)
# Example: https://admin.giron.app,https://giron.app
ALLOWED_ORIGINS=

# ── Логирование и прокси ────────────────────────────────────────────────────
# LOG_LEVEL: debug | info | warn | error (по умолчанию info)
# LOG_LEVEL=info
# TRUST_PROXY нужен на Render/Heroku, иначе rate-limit видит один IP балансировщика
# вместо реальных адресов и лимит срабатывает на всех сразу.
# TRUST_PROXY=1

# ── Telegram-логгер ошибок ──────────────────────────────────────────────────
# Клиентские краши и алерты уходят основателю в личку. Бот: @BotFather.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── Лимиты SMS ──────────────────────────────────────────────────────────────
# Защита от слива баланса при переборе кодов. Значения по умолчанию в коде.
# SMS_MAX_PER_HOUR=
# SMS_MAX_PER_DAY=

# ── LLM-роутер (объявлен, подключён только Mistral) ─────────────────────────
# Цепочка провайдеров существует в коде, но зарегистрирован один адаптер —
# yandex и gigachat закомментированы. Переменные ниже читаются роутером.
# AI_PRIMARY_PROVIDER=mistral
# AI_COMPLEX_PROVIDER=      # модель для тяжёлых запросов
# AI_SAFETY_PROVIDER=       # модель для проверки на небезопасный контент
# AI_CONTEXT_TOKENS=        # потолок контекста, символов
# AI_VISION_MODEL=          # распознавание фото еды
# OLLAMA_URL=http://localhost:11434   # локальный fallback, к роутеру НЕ подключён

# ── YandexGPT / SpeechKit (не активны) ──────────────────────────────────────
# YANDEX_API_KEY=
# YANDEX_FOLDER_ID=
# YANDEX_MODEL=
# YANDEX_SPEECHKIT_API_KEY=   # голосовой ввод в чате
