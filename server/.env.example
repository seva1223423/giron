DATABASE_URL="postgresql://user:password@localhost:5432/iron_gym"
JWT_SECRET="your-secret-key-here"
JWT_REFRESH_SECRET="your-refresh-secret-here"
PORT=3000

# ── AI Provider (primary) ───────────────────────────────────────────────────
# OpenAI-совместимый endpoint, переключается через env — код не меняется.
# Миграционный план и сравнение провайдеров (cost, latency, страновой риск):
# см. server/src/services/llm/README.md
#
# Mistral AI (сейчас по умолчанию, бесплатный tier 1B токенов/месяц):
#   Регистрация: https://console.mistral.ai
#   Минусы: оплата только через иностранное юрлицо, риск санкционной
#   блокировки РФ. Держать как fallback после миграции на YandexGPT.
AI_BASE_URL=https://api.mistral.ai/v1
AI_MODEL=mistral-small-latest
AI_API_KEY=your-mistral-api-key-here
#
# DeepSeek (альтернатива, $0.14/1M, оплата в $):
#   Регистрация: https://platform.deepseek.com
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat
# AI_API_KEY=your-deepseek-api-key-here
#
# YandexGPT (рекомендуемый primary для РФ, в 3× дешевле Mistral):
#   Документация: https://yandex.cloud/ru/docs/foundation-models/
#   Tariff Lite async: ~120 ₽ / 1M токенов, оплата в ₽ через Yandex Cloud.
#   Плюсы: 0 валютных рисков, нет санкций, нативный русский + казахский.
#   Минус: не OpenAI-совместим нативно — см. llm/README.md для интеграции.
# YANDEX_GPT_API_KEY=your-yc-api-key
# YANDEX_GPT_FOLDER_ID=b1gxxxxxxxxxxxxxxxxx
# YANDEX_GPT_MODEL=yandexgpt-lite/latest
#
# GigaChat (Сбер, fallback для страновой устойчивости):
#   Документация: https://developers.sber.ru/docs/ru/gigachat/
#   Tariff: 190-1950 ₽/1M токенов, freemium 1M токенов.
# GIGACHAT_CLIENT_ID=
# GIGACHAT_CLIENT_SECRET=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
#
# Fallback chain — порядок попыток при ошибке primary. Реализация
# ожидается вместе с подключением альтернативного провайдера (см. README).
# Пример: AI_FALLBACK_CHAIN=mistral,gigachat
# AI_FALLBACK_CHAIN=

# Webhook signature secrets
# ЮKassa — primary payment channel for the RF market.
YUKASSA_WEBHOOK_SECRET=your-yukassa-secret-key
# Generic HMAC signature — optional, for a custom payment integration.
WEBHOOK_SECRET=your-generic-webhook-secret
# RevenueCat is intentionally unsupported: Apple/Google Play Billing is not
# available from RF since 2022. Do not add a REVENUECAT_* env here.

# ── Google OAuth ────────────────────────────────────────────────────────────
# Создать проект: https://console.cloud.google.com → APIs → Credentials
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=

# ── VK OAuth ────────────────────────────────────────────────────────────────
# Создать приложение: https://vk.com/editapp?act=create (тип: Мобильное)
VK_APP_ID=

# ── SMS.ru (рекомендуется для России) ───────────────────────────────────────
# Регистрация: https://sms.ru — бесплатный тестовый баланс
# Дешевле и надёжнее Twilio для российских номеров
SMSRU_API_ID=
SMSRU_SENDER=IronGym     # опционально: имя отправителя (одобрить в личном кабинете)

# ── Twilio (международный fallback) ─────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password    # Gmail: Account → Security → App Passwords
SMTP_FROM=Iron Gym <noreply@irongym.app>
APP_URL=https://irongym.app

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed web origins (mobile app doesn't need this)
# Example: https://admin.irongym.app,https://irongym.app
ALLOWED_ORIGINS=
