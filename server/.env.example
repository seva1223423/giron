DATABASE_URL="postgresql://user:password@localhost:5432/iron_gym"
JWT_SECRET="your-secret-key-here"
JWT_REFRESH_SECRET="your-refresh-secret-here"
PORT=3000

# AI Provider — OpenAI-совместимый, переключается через env (код не меняется)
#
# Mistral AI (бесплатно, 1B токенов/месяц — для разработки):
#   Регистрация: https://console.mistral.ai
AI_BASE_URL=https://api.mistral.ai/v1
AI_MODEL=mistral-small-latest
AI_API_KEY=your-mistral-api-key-here
#
# DeepSeek (продакшен, $0.14/1M токенов):
#   Регистрация: https://platform.deepseek.com
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat
# AI_API_KEY=your-deepseek-api-key-here

# Webhook signature secrets
REVENUECAT_WEBHOOK_SECRET=your-revenuecat-webhook-secret
YUKASSA_WEBHOOK_SECRET=your-yukassa-secret-key
WEBHOOK_SECRET=your-generic-webhook-secret

# ── Google OAuth ────────────────────────────────────────────────────────────
# Создать проект: https://console.cloud.google.com → APIs → Credentials
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=

# ── VK OAuth ────────────────────────────────────────────────────────────────
# Создать приложение: https://vk.com/editapp?act=create (тип: Мобильное)
VK_APP_ID=

# ── SMS.ru (рекомендуется для России) ───────────────────────────────────────
# Регистрация: https://sms.ru — бесплатный тестовый баланс
# Дешевле и надёжнее Twilio для российских номеров
SMSRU_API_ID=
SMSRU_SENDER=IronGym     # опционально: имя отправителя (одобрить в личном кабинете)

# ── Twilio (международный fallback) ─────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password    # Gmail: Account → Security → App Passwords
SMTP_FROM=Iron Gym <noreply@irongym.app>
APP_URL=https://irongym.app

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed web origins (mobile app doesn't need this)
# Example: https://admin.irongym.app,https://irongym.app
ALLOWED_ORIGINS=
