# the app go to assets/exercise-videos/ and ARE committed.
exercise-videos-raw/
exercise-videos-ready/
exercise-videos-rendered/
exercise-videos-wikimedia/
exercise-videos-test/

# Environment variables — NEVER commit these
.env
server/.env
*.env.local

# Tooling credentials (Render API key, Neon tokens, etc.) used by Claude to
# help debug the live environment. Must NEVER be committed — see secrets/README.md.
secrets/

# Build output
dist/
server/dist/
build/

# Expo
.expo/
web-build/

# Logs
*.log
npm-debug.log*

