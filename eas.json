{
  "cli": {
    "version": ">= 3.0.0",
    "requireCommit": false,
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "autoIncrement": true,
      "android": {
        "buildType": "apk",
        "credentialsSource": "local"
      },
      "env": {
        "EXPO_PUBLIC_STORE": "universal",
        "EXPO_PUBLIC_YANDEX_CLIENT_ID": "b90db3d6510c47be811fa535cf0cddd0"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "apk",
        "credentialsSource": "local"
      },
      "env": {
        "EXPO_PUBLIC_STORE": "universal",
        "EXPO_PUBLIC_YANDEX_CLIENT_ID": "b90db3d6510c47be811fa535cf0cddd0"
      }
    },
    "rustore": {
      "extends": "preview",
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "apk",
        "credentialsSource": "local"
      },
      "env": {
        "EXPO_PUBLIC_STORE": "rustore",
        "EXPO_PUBLIC_API_URL": "https://iron-gym-swoe.onrender.com/api",
        "EXPO_PUBLIC_YANDEX_CLIENT_ID": "b90db3d6510c47be811fa535cf0cddd0"
      }
    },
    "play": {
      "extends": "production",
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_STORE": "play",
        "EXPO_PUBLIC_API_URL": "https://iron-gym-swoe.onrender.com/api",
        "EXPO_PUBLIC_YANDEX_CLIENT_ID": "b90db3d6510c47be811fa535cf0cddd0"
      }
    },
    "appstore": {
      "extends": "production",
      "channel": "production",
      "autoIncrement": true,
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_STORE": "appstore",
        "EXPO_PUBLIC_API_URL": "https://iron-gym-swoe.onrender.com/api",
        "EXPO_PUBLIC_YANDEX_CLIENT_ID": "b90db3d6510c47be811fa535cf0cddd0"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_STORE": "universal",
        "EXPO_PUBLIC_YANDEX_CLIENT_ID": "b90db3d6510c47be811fa535cf0cddd0"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
