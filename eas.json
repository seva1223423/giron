{
  "cli": {
    "version": ">= 3.0.0",
    "requireCommit": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "credentialsSource": "local"
      },
      "env": {
        "EXPO_PUBLIC_STORE": "universal"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "credentialsSource": "local"
      },
      "env": {
        "EXPO_PUBLIC_STORE": "universal",
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB": "752233520722-5tq411j4bv3d8fla9sf3iothtk6g255v.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID": "752233520722-jnlgc229ip1tsmp3umvj6m7hjrlgtrvt.apps.googleusercontent.com"
      }
    },
    "rustore": {
      "extends": "preview",
      "distribution": "store",
      "android": {
        "buildType": "apk",
        "credentialsSource": "local"
      },
      "env": {
        "EXPO_PUBLIC_STORE": "rustore",
        "EXPO_PUBLIC_API_URL": "https://iron-gym-swoe.onrender.com/api"
      }
    },
    "play": {
      "extends": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_STORE": "play",
        "EXPO_PUBLIC_API_URL": "https://iron-gym-swoe.onrender.com/api"
      }
    },
    "appstore": {
      "extends": "production",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_STORE": "appstore",
        "EXPO_PUBLIC_API_URL": "https://iron-gym-swoe.onrender.com/api"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_STORE": "universal"
      }
    }
  }
}
