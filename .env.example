# Copy this file to .env for local development (Expo Go / `npm start`).
# These EXPO_PUBLIC_* vars are baked into the client bundle at build time;
# eas.json provides the same values for EAS-built APKs (development /
# preview / production / play profiles).
#
# Google Sign-In does not work in RuStore builds (EXPO_PUBLIC_STORE=rustore)
# — the GoogleAuthButton is hidden by features.googleOAuth flag in
# src/config/store.ts.

# Store target controls which auth/payment surfaces are visible.
# "universal" = dev mode, show everything. Other values: rustore, play, appstore.
EXPO_PUBLIC_STORE=universal

# Google OAuth client IDs (PUBLIC — safe to commit). Without these the
# "Войти через Google" button is hidden by googleConfigured guard in
# LoginScreen / RegisterScreen / LinkedAccountsScreen.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=752233520722-5tq411j4bv3d8fla9sf3iothtk6g255v.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=752233520722-jnlgc229ip1tsmp3umvj6m7hjrlgtrvt.apps.googleusercontent.com

# VK ID and Yandex client IDs — fill these when ready (button hides without).
# EXPO_PUBLIC_VK_APP_ID=
# EXPO_PUBLIC_YANDEX_CLIENT_ID=
