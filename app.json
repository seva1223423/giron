{
  "expo": {
    "name": "Giron",
    "slug": "iron-gym",
    "scheme": [
      "giron",
      "com.giron.app",
      "irongym"
    ],
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0F"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSMotionUsageDescription": "Используется для подсчёта шагов и отслеживания активности"
      },
      "associatedDomains": [
        "applinks:giron.app",
        "applinks:irongym.app"
      ]
    },
    "android": {
      "package": "com.giron.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0F"
      },
      "splash": {
        "backgroundColor": "#0A0A0F"
      },
      "edgeToEdgeEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "giron"
            },
            {
              "scheme": "irongym"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "giron.app",
              "pathPrefix": "/reset-password"
            },
            {
              "scheme": "https",
              "host": "giron.app",
              "pathPrefix": "/auth"
            },
            {
              "scheme": "https",
              "host": "irongym.app",
              "pathPrefix": "/reset-password"
            },
            {
              "scheme": "https",
              "host": "irongym.app",
              "pathPrefix": "/auth"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "versionCode": 11
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "8b6fa1fd-4943-4185-bf1a-ea14bc70cfc4"
      }
    },
    "owner": "memno666",
    "updates": {
      "url": "https://u.expo.dev/8b6fa1fd-4943-4185-bf1a-ea14bc70cfc4",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 5000,
      "enabled": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
